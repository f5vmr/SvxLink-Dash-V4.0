#!/bin/bash

set -eu

GPIO_RULE="/etc/udev/rules.d/99-svxlink-gpio.rules"

usage()
{
    echo "Usage: $0 gpio|no-gpio" >&2
    exit 2
}

if [ "$#" -ne 1 ]; then
    usage
fi

MODE="$1"

case "$MODE" in
    gpio|no-gpio)
        ;;
    *)
        usage
        ;;
esac

if ! id svxlink >/dev/null 2>&1; then
    echo "ERROR: The svxlink service account does not exist." >&2
    exit 1
fi

SVXLINK_GROUPS="audio,plugdev,dialout"

if [ "$MODE" = "gpio" ]; then
    if ! compgen -G '/dev/gpiochip*' >/dev/null; then
        echo "ERROR: No GPIO character devices are exposed." >&2
        exit 1
    fi

    if ! getent group gpio >/dev/null 2>&1; then
        groupadd --system gpio
    fi

    SVXLINK_GROUPS="${SVXLINK_GROUPS},gpio"

    install -d \
        -o root \
        -g root \
        -m 0755 \
        /etc/udev/rules.d

    cat > "$GPIO_RULE" <<'EOF'
# Permit members of the gpio group to use GPIO character devices.
SUBSYSTEM=="gpio", KERNEL=="gpiochip[0-9]*", GROUP="gpio", MODE="0660"
EOF

    chmod 0644 "$GPIO_RULE"
    chown root:root "$GPIO_RULE"
fi

if [ -n "$SVXLINK_GROUPS" ]; then
    usermod \
        -a \
        -G "$SVXLINK_GROUPS" \
        svxlink
fi

if [ "$MODE" = "gpio" ]; then
    udevadm control --reload-rules
    udevadm trigger \
        --subsystem-match=gpio \
        --action=change
    udevadm settle

    for GPIO_DEVICE in /dev/gpiochip*; do
        if [ ! -e "$GPIO_DEVICE" ]; then
            continue
        fi

        chgrp gpio "$GPIO_DEVICE"
        chmod 0660 "$GPIO_DEVICE"
    done
fi

exit 0